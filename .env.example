# --- Vercel (Project → Settings → Environment Variables) ---
# Required for contact + valuation forms → Follow Up Boss:
FUB_API_KEY=
#
# Google Cloud → Other products → Maps Platform → enable "Maps JavaScript API".
# Restrict key by HTTP referrer (Website restrictions):
#   https://www.skyesummithomes.com/*
#   https://skyesummithomes.com/*
#   http://localhost:*
# Vercel: set GOOGLE_MAPS_API_KEY; build must run `npm run build` (see vercel.json) so
# scripts/inject-google-maps-key.js embeds the key into las-vegas-zip-code-map/index.html.
GOOGLE_MAPS_API_KEY=
#
# Google Search Console HTML tag verification (optional; build injects default token)
GOOGLE_SITE_VERIFICATION=
#
# Parallel Search + Task API (optional; refresh SEO/GEO/AEO research)
PARALLEL_API_KEY=
#
# Cloudflare Images (hosted). Git /images/ is the origin backup on Vercel.
# Delivery: https://imagedelivery.net/byE6BTe9lNqo21V57n4aPQ/<image_id>/<variant>
# Variants: public | hero | section | card | w960 | avatar | og
# Upload requires an API token with Images Write, then: npm run images:cloudflare
CLOUDFLARE_IMAGES_ACCOUNT_HASH=byE6BTe9lNqo21V57n4aPQ
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
CLOUDFLARE_API_TOKEN=
# Optional: use flexible variant URLs (w=960,fit=scale-down) instead of named variants
CLOUDFLARE_IMAGES_FLEXIBLE=
# Optional Worker transforms for files not yet uploaded (orange-cloud OK on images subdomain only):
CLOUDFLARE_IMAGES_ENABLED=
CLOUDFLARE_IMAGES_HOST=https://images.skyesummithomes.com
#
# Local map test (PowerShell): $env:FORCE_MAPS_INJECT="1"; $env:GOOGLE_MAPS_API_KEY="your_key"; npm run build
# Then restore empty content= on las-vegas-zip-code-map meta before commit if the file changed.
